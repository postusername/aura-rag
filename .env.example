# Kaiten API credentials (required)
KAITEN_TOKEN=your_kaiten_api_token_here
KAITEN_DOMAIN=your_workspace_subdomain

# Google AI Studio API key — free at https://aistudio.google.com/apikey (required unless using Ollama)
GOOGLE_API_KEY=your_google_api_key_here

# Ollama local model — set to enable local embeddings (optional)
# Available models: nomic-embed-text, mxbai-embed-large, bge-m3
# If not set, the Ollama container will exit immediately (expected behavior)
# OLLAMA_MODEL=nomic-embed-text
