{
  "mcpServers": {
    "kaiten": {
      "command": "node",
      "args": ["./kaiten-mcp/index.js"],
      "env": {
        "KAITEN_TOKEN": "${KAITEN_TOKEN}",
        "KAITEN_DOMAIN": "${KAITEN_DOMAIN}"
      }
    },
    "rag": {
      "command": "docker",
      "args": ["exec", "-i", "aura-rag-rag-server-1", "python", "/app/src/main.py", "--stdio"]
    }
  }
}
